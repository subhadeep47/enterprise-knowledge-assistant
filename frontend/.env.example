# Spring Boot backend base URL. Leave blank when Vite proxies /api to the backend.
VITE_API_BASE_URL=http://localhost:8080

# true = local demo login and mock responses; false = call the Spring Boot backend.
VITE_DEMO_MODE=true

# Spring Security OAuth2 login endpoint used when demo mode is disabled.
VITE_GOOGLE_LOGIN_PATH=/oauth2/authorization/google
